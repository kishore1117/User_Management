pipeline {
    agent any

    environment {
        NODE_VERSION = "18"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"
    }

    tools {
        nodejs "NodeJS-${NODE_VERSION}"   // Configure in Jenkins Global Tools
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'prod_branch',
                url: 'https://github.com/kishore1117/User_Management.git'
            }
        }

        stage('Install Backend Dependencies') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh 'npm install'
                }
            }
        }

        stage('Install Frontend Dependencies') {
            steps {
                dir("${FRONTEND_DIR}") {
                    sh 'npm install'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir("${FRONTEND_DIR}") {
                    sh 'npm run build'
                }
            }
        }

        stage('Install PM2') {
            steps {
                sh 'npm install -g pm2 || true'
            }
        }

        stage('Stop Existing Services') {
            steps {
                sh '''
                pm2 stop all || true
                pm2 delete all || true
                '''
            }
        }

        stage('Start Backend Service') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh 'pm2 start src/index.js --name backend-app'
                }
            }
        }

        stage('Start Frontend Service') {
            steps {
                dir("${FRONTEND_DIR}") {
                    sh 'pm2 start npm --name frontend-app -- start'
                }
            }
        }

        stage('Save PM2 Process') {
            steps {
                sh 'pm2 save'
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful!'
        }
        failure {
            echo 'Deployment Failed!'
        }
    }
}
